---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="404 - Page Not Found | Wordle Hint Today"
    description="Oops! The page you are looking for does not exist or the puzzle hasn't been released yet."
>
    <main class="error-page fade-in-up">
        <div class="error-container">
            <!-- Wordle Styled 404 Grid -->
            <div class="wordle-grid">
                <div class="tile absent">4</div>
                <div class="tile correct">0</div>
                <div class="tile absent">4</div>
            </div>

            <h1>Oops! Word Not Found</h1>
            
            <p class="error-message">
                It looks like you've guessed a URL that isn't in our dictionary. 
                If you were looking for a specific Wordle hint, it's possible that <strong>the puzzle hasn't been released yet</strong> in your timezone!
            </p>

            <div class="action-buttons">
                <a href="/" class="btn-primary">Go to Today's Hint</a>
                <a href="/past-answers" class="btn-secondary">Browse Past Answers</a>
            </div>
        </div>
    </main>
</Layout>

<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .fade-in-up {
        animation: fadeInUp 0.5s ease-out forwards;
    }

    .error-page {
        max-width: 800px;
        margin: auto;
        padding: 4rem 1rem 8rem;
        text-align: center;
        font-family: 'Open Sans', sans-serif;
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .error-container {
        background: #ffffff;
        border: 1px solid #eaeced;
        border-radius: 24px;
        padding: 4rem 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        width: 100%;
    }

    .wordle-grid {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-bottom: 2.5rem;
    }

    .tile {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: 900;
        color: white;
        border-radius: 8px;
        font-family: 'Open Sans', sans-serif;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    }

    .correct { background-color: #6aaa64; border: 2px solid #6aaa64; }
    .absent { background-color: #787c7e; border: 2px solid #787c7e; }

    h1 {
        font-family: 'Georgia', serif;
        font-size: 2.5rem;
        font-weight: 900;
        color: #1a1a1b;
        margin-bottom: 1rem;
    }

    .error-message {
        font-size: 1.15rem;
        line-height: 1.6;
        color: #555;
        max-width: 550px;
        margin: 0 auto 2.5rem;
    }

    .error-message strong {
        color: #1a1a1b;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: #6aaa64;
        color: white;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 10px rgba(106, 170, 100, 0.3);
    }

    .btn-primary:hover {
        background: #5c9656;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(106, 170, 100, 0.4);
    }

    .btn-secondary {
        background: #1a1a1b;
        color: white;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-secondary:hover {
        background: #333;
        transform: translateY(-2px);
    }

    @media (max-width: 600px) {
        .error-container {
            padding: 3rem 1.5rem;
        }
        .tile {
            width: 65px;
            height: 65px;
            font-size: 2.5rem;
        }
        h1 {
            font-size: 2rem;
        }
        .action-buttons {
            flex-direction: column;
        }
        .btn-primary, .btn-secondary {
            width: 100%;
        }
    }
</style>