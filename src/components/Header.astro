---
---

<header class="sticky top-0 z-50 bg-white border-b border-[#d3d6da] shadow-sm">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        
        <!-- Mobile Menu Icon (Now with ID for JS) -->
        <button 
            id="mobile-menu-btn"
            class="md:hidden flex items-center justify-center w-10 h-10 rounded hover:bg-gray-100 transition"
            aria-label="Toggle menu"
            aria-expanded="false"
        >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M3 6h18M3 12h18M3 18h18" stroke="#1a1a1b" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>

        <!-- Logo -->
        <a href="/" class="absolute left-1/2 -translate-x-1/2 md:static md:translate-x-0 flex items-center gap-2">
            <img 
                src="/logo.webp"
                alt="Wordle Hint Today Logo"
                width="40"
                height="40"
                class="w-9 h-9 md:w-10 md:h-10 rounded shadow-sm"
                loading="eager"
            />
            <span class="font-bold text-xl md:text-2xl tracking-tight text-[#1a1a1b]">
                Wordle Hint
            </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex ml-auto items-center gap-6 text-sm font-semibold">
            <a href="/" class="text-gray-600 hover:text-[#6aaa64] transition">Today's Hint</a>
            <a href="/past-answers" class="text-gray-600 hover:text-[#6aaa64] transition">Past Answers</a>
            <a href="/blog/how-to-play-wordle" class="text-gray-600 hover:text-[#6aaa64] transition">How To Play</a>
        </nav>
    </div>

    <!-- Mobile Dropdown Menu (Hidden by default) -->
    <nav id="mobile-menu" class="hidden md:hidden absolute top-16 left-0 w-full bg-white border-b border-[#d3d6da] flex-col shadow-lg z-40">
        <a href="/" class="block px-6 py-4 text-gray-800 font-semibold border-b border-gray-100 hover:bg-gray-50">Today's Hint</a>
        <a href="/past-answers" class="block px-6 py-4 text-gray-800 font-semibold border-b border-gray-100 hover:bg-gray-50">Past Answers</a>
        <a href="/blog/how-to-play-wordle" class="block px-6 py-4 text-gray-800 font-semibold hover:bg-gray-50">How To Play</a>
    </nav>
</header>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("mobile-menu");

        btn?.addEventListener("click", () => {
            const isHidden = menu.classList.contains("hidden");
            if (isHidden) {
                menu.classList.remove("hidden");
                menu.classList.add("flex");
                btn.setAttribute("aria-expanded", "true");
            } else {
                menu.classList.add("hidden");
                menu.classList.remove("flex");
                btn.setAttribute("aria-expanded", "false");
            }
        });
    });
</script>