---
interface Props {
	vowels: number;
	consonants: number;
	startingLetter: string;
	endingLetter: string;
	hasRepeating: boolean;
}

const {
	vowels,
	consonants,
	startingLetter,
	endingLetter,
	hasRepeating
} = Astro.props;

---

<section class="hint-section">


<div class="section-header">

<h2>
	Today's Wordle Hints
</h2>

<p>
	Open each clue when you need help solving today's puzzle.
</p>

</div>




<div class="hint-grid">



<!-- VOWELS -->

<div class="hint-card yellow">


<div class="tile">
	V
</div>


<div>

<h3>
	Vowels
</h3>


<p>
	The answer contains
	<strong>
		{vowels}
	</strong>
	vowels.
</p>


</div>


</div>





<!-- START -->

<div class="hint-card green">


<div class="tile">
	S
</div>


<div>

<h3>
	Starting Letter
</h3>


<p>
	The word starts with
	<strong>
		{startingLetter}
	</strong>
</p>


</div>


</div>





<!-- END -->

<div class="hint-card gray">


<div class="tile">
	E
</div>


<div>

<h3>
	Ending Letter
</h3>


<p>
	The word ends with
	<strong>
		{endingLetter}
	</strong>
</p>


</div>


</div>





<!-- PATTERN -->


<div class="hint-card dark">


<div class="tile">
	?
</div>


<div>

<h3>
	Letter Pattern
</h3>


<p>

{
hasRepeating
?
"Contains repeating letters"
:
"All letters are unique"
}

</p>


</div>


</div>



</div>


</section>




<style>


.hint-section{

	margin:3rem auto;

}



.section-header{

	text-align:center;

	margin-bottom:2rem;

}



.section-header h2{

	font-family:Georgia,serif;

	font-size:2rem;

	font-weight:900;

	color:#1a1a1b;

	margin-bottom:.5rem;

}



.section-header p{

	color:#666;

}





.hint-grid{


display:grid;

grid-template-columns:repeat(4,1fr);

gap:1rem;


}




.hint-card{


background:white;

border:1px solid #d3d6da;

border-radius:18px;

padding:1.25rem;

display:flex;

flex-direction:column;

gap:1rem;


transition:.3s ease;


}



.hint-card:hover{


transform:translateY(-6px);


box-shadow:
0 15px 35px rgba(0,0,0,.08);


}



.tile{


width:42px;

height:42px;

display:flex;

align-items:center;

justify-content:center;


border-radius:8px;


font-size:1.3rem;

font-weight:900;

color:white;


}



.yellow .tile{

background:#c9b458;

}


.green .tile{

background:#6aaa64;

}


.gray .tile{

background:#787c7e;

}



.dark .tile{

background:#1a1a1b;

}





.hint-card h3{


font-size:1.1rem;

font-weight:800;

margin:0 0 .3rem;

color:#1a1a1b;


}




.hint-card p{


color:#666;

line-height:1.5;

font-size:.95rem;


}



.hint-card strong{


font-size:1.15rem;

color:#1a1a1b;

}




@media(max-width:900px){


.hint-grid{

grid-template-columns:repeat(2,1fr);

}


}




@media(max-width:500px){


.hint-grid{

grid-template-columns:1fr;

}


}



</style>