---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#d3d6da] bg-white mt-16">
    <div class="max-w-6xl mx-auto px-4 py-12">
        <!-- Footer Top -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

            <!-- Brand -->
            <div>
                <a 
                    href="/"
                    class="flex items-center gap-2 mb-4"
                >
                    <img
                        src="/logo.webp"
                        alt="Wordle Hint Today"
                        width="32"
                        height="32"
                        class="w-8 h-8 rounded"
                    />
                    <span class="font-bold text-lg text-[#1a1a1b]">
                        Wordle Hint Today
                    </span>
                </a>
                <p class="text-sm text-gray-600 leading-6">
                    Get daily Wordle hints, clues, answers, and puzzle analysis.
                    Our goal is to help players solve Wordle with smart progressive hints.
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <h2 class="font-bold text-[#1a1a1b] mb-4">
                    Explore
                </h2>
                <ul class="space-y-3 text-sm text-gray-600">
                    <li>
                        <a 
                            href="/"
                            class="hover:text-black transition"
                        >
                            Today's Wordle Hint
                        </a>
                    </li>
                    <li>
                        <a 
                            href="/past-answers"
                            class="hover:text-black transition"
                        >
                            Past Wordle Answers
                        </a>
                    </li>
                    <li>
                        <!-- 🚨 CRITICAL FIX: Added /blog/ to the URL to fix the 404 error 🚨 -->
                        <a 
                            href="/blog/how-to-play-wordle"
                            class="hover:text-black transition"
                        >
                            How To Play Wordle
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Legal -->
            <div>
                <h2 class="font-bold text-[#1a1a1b] mb-4">
                    Information
                </h2>
                <ul class="space-y-3 text-sm text-gray-600">
                    <li>
                        <a 
                            href="/about"
                            class="hover:text-black transition"
                        >
                            About Us
                        </a>
                    </li>
                    <li>
                        <a 
                            href="/contact"
                            class="hover:text-black transition"
                        >
                            Contact
                        </a>
                    </li>
                    <li>
                        <a 
                            href="/privacy-policy"
                            class="hover:text-black transition"
                        >
                            Privacy Policy
                        </a>
                    </li>
                    <li>
                        <a 
                            href="/terms-of-service"
                            class="hover:text-black transition"
                        >
                            Terms
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Disclaimer -->
        <div class="border-t border-gray-200 mt-10 pt-6">
            <p class="text-xs text-gray-500 leading-5 text-center max-w-3xl mx-auto">
                © {currentYear} WordleHintToday.online.
                We are an independent Wordle resource and are not affiliated with,
                sponsored by, or endorsed by The New York Times Company.
            </p>
        </div>
    </div>
</footer>