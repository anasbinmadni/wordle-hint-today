---
import Layout from "../../layouts/Layout.astro";
import SEO from "../../components/SEO.astro";

const blogSchema = {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Wordle Hint Today Blog",
    "description": "Read the latest guides, tips, strategies, and comparisons for Wordle players.",
    "url": "https://wordlehinttoday.online/blog"
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://wordlehinttoday.online"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog"
        }
    ]
};
---

<Layout
    title="Wordle Blog - Tips, Strategies & Guides"
    description="Explore the best Wordle strategies, starting words, and gameplay tips on the official Wordle Hint Today blog."
>
    <SEO
        title="Wordle Blog - Tips, Strategies & Guides"
        description="Explore the best Wordle strategies, starting words, and gameplay tips on the official Wordle Hint Today blog."
        canonical="https://wordlehinttoday.online/blog"
    />

    <!-- is:inline strictly added for SEO bots -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <main class="blog-hub">
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <strong>Blog</strong>
        </nav>

        <header class="hero">
            <h1>Wordle Hint Today Blog</h1>
            <p>
                Master the game with our expert guides, best starting words, and winning strategies. Whether you are a beginner or a seasoned pro, we have something for you.
            </p>
        </header>

        <section class="articles-grid">
            <!-- Article 1 -->
            <a href="/blog/how-to-play-wordle" class="article-card">
                <span class="category">Beginner Guide</span>
                <h2>How To Play Wordle: Complete Beginner Guide</h2>
                <p>Learn the rules, understand the colored tiles, and discover simple strategies to solve your daily puzzle.</p>
                <span class="read-more">Read Article →</span>
            </a>

            <!-- Article 2 -->
            <a href="/blog/best-wordle-starting-words" class="article-card">
                <span class="category">Strategy</span>
                <h2>Best Wordle Starting Words To Win More Games</h2>
                <p>Discover which opening words reveal the most useful letters and how to choose a strong first guess for Wordle.</p>
                <span class="read-more">Read Article →</span>
            </a>

            <!-- Article 3 -->
            <a href="/blog/wordle-tips-and-tricks" class="article-card">
                <span class="category">Advanced Tips</span>
                <h2>Wordle Tips And Tricks To Improve Your Score</h2>
                <p>Use smarter guesses, understand letter patterns, and improve your daily Wordle solving strategy.</p>
                <span class="read-more">Read Article →</span>
            </a>

            <!-- Article 4 -->
            <a href="/blog/wordle-vs-connections" class="article-card">
                <span class="category">Game Comparison</span>
                <h2>Wordle vs Connections: What's The Difference?</h2>
                <p>Compare two popular daily word games and learn how their rules, strategies, and solving methods are different.</p>
                <span class="read-more">Read Article →</span>
            </a>
        </section>
    </main>
</Layout>

<style>
    .blog-hub { max-width: 1000px; margin: auto; padding: 2rem 1rem 5rem; }
    
    .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.9rem; color: #666; margin-bottom: 2rem; flex-wrap: wrap; }
    .breadcrumb a { color: #1a1a1b; font-weight: 700; text-decoration: none; }
    .breadcrumb a:hover { color: #6aaa64; text-decoration: underline; }
    
    .hero { text-align: center; margin-bottom: 4rem; padding: 2rem 0; }
    .hero h1 { font-family: Georgia, serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: #1a1a1b; margin-bottom: 1rem; }
    .hero p { font-size: 1.2rem; color: #666; max-width: 700px; margin: auto; line-height: 1.8; }
    
    .articles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    
    .article-card { background: white; border: 1px solid #d3d6da; border-radius: 20px; padding: 2rem; display: flex; flex-direction: column; text-decoration: none; transition: 0.3s ease; }
    .article-card:hover { transform: translateY(-5px); border-color: #6aaa64; box-shadow: 0 15px 35px rgba(106, 170, 100, 0.1); }
    
    .category { display: inline-block; background: #f3f3f3; color: #555; padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; align-self: flex-start; margin-bottom: 1rem; transition: 0.3s ease; }
    .article-card:hover .category { background: #6aaa64; color: white; }
    
    .article-card h2 { font-family: Georgia, serif; font-size: 1.8rem; font-weight: 900; color: #1a1a1b; margin-bottom: 1rem; line-height: 1.3; }
    .article-card p { color: #666; line-height: 1.8; margin-bottom: 2rem; flex-grow: 1; }
    
    .read-more { font-weight: 900; color: #1a1a1b; transition: 0.2s ease; }
    .article-card:hover .read-more { color: #6aaa64; }

    @media (max-width: 768px) {
        .articles-grid { grid-template-columns: 1fr; }
        .hero h1 { font-size: 2.5rem; }
        .article-card { padding: 1.5rem; }
        .article-card h2 { font-size: 1.5rem; }
    }
</style>