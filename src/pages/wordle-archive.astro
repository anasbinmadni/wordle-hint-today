---
import Layout from "../layouts/Layout.astro";
import SEO from "../components/SEO.astro";


const currentDate = new Date();

const archives = [];


for(let i = 1; i <= 30; i++){

	const date = new Date();

	date.setDate(date.getDate() - i);


	const year = date.getFullYear();

	const month =
	String(date.getMonth()+1).padStart(2,"0");

	const day =
	String(date.getDate()).padStart(2,"0");


	archives.push({

		date:
		date.toLocaleDateString(
		"en-US",
		{
			month:"long",
			day:"numeric",
			year:"numeric"
		}
		),

		url:
		`/wordle-hint-${1000-i}-${year}-${month}-${day}`

	});

}


---

<Layout

title="Wordle Archive - Past Wordle Answers & History"

description="Browse the Wordle archive with previous answers, puzzle history, and daily solutions from past Wordle games."

>



<SEO

title="Wordle Archive - Past Wordle Answers"

description="Explore previous Wordle answers and puzzle history. Browse old Wordle solutions and daily puzzle archives."

canonical="/wordle-archive"

/>




<main class="page">


<section class="hero">


<h1>
Wordle Archive
</h1>


<p>
Explore previous Wordle answers, puzzle history, and past daily solutions.
</p>


</section>




<section class="card">


<h2>
Past Wordle Answers
</h2>


<p>

Looking for an older Wordle solution?

Browse our archive of previous puzzles and revisit daily Wordle answers.

</p>


</section>





<section class="archive-grid">


{

archives.map((item,index)=>(

<a

href={item.url}

class="archive-card"

>

<span>
Wordle #{1000-index}
</span>


<strong>
{item.date}
</strong>


<span class="arrow">
→
</span>


</a>

))

}



</section>




<section class="card">


<h2>
Why Use The Wordle Archive?
</h2>


<ul>

<li>
Review previous Wordle solutions.</li>

<li>
Improve your solving strategy.</li>

<li>
Study common five-letter words.</li>

<li>
Compare puzzle difficulty.</li>

</ul>


</section>





<section class="card">


<h2>
Explore More Wordle Tools
</h2>


<div class="links">


<a href="/wordle-solver">
Wordle Solver
</a>


<a href="/today-wordle-hint">
Today's Hints
</a>


<a href="/today-wordle-answer">
Today's Answer
</a>


</div>


</section>



</main>



</Layout>



