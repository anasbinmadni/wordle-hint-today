---
---

<header class="sticky top-0 z-50 bg-white border-b border-[#d3d6da]">

	<div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">


		<!-- Mobile Menu Icon -->
		<button 
			class="md:hidden flex items-center justify-center w-10 h-10 rounded hover:bg-gray-100"
			aria-label="Open menu"
		>
			<svg 
				width="24" 
				height="24" 
				viewBox="0 0 24 24" 
				fill="none"
			>
				<path 
					d="M3 6h18M3 12h18M3 18h18"
					stroke="#1a1a1b"
					stroke-width="2"
					stroke-linecap="round"
				/>
			</svg>
		</button>



		<!-- Logo -->
		<a 
			href="/" 
			class="absolute left-1/2 -translate-x-1/2 flex items-center gap-2"
		>

			<img 
				src="/logo.webp"
				alt="Wordle Hint Today Logo"
				width="40"
				height="40"
				class="w-9 h-9 md:w-10 md:h-10 rounded"
			/>

			<span 
				class="font-bold text-xl md:text-2xl tracking-tight text-[#1a1a1b]"
			>
				Wordle Hint
			</span>

		</a>



		<!-- Desktop Navigation -->
		<nav class="hidden md:flex ml-auto items-center gap-6 text-sm font-semibold">

			<a 
				href="/"
				class="text-gray-600 hover:text-black transition"
			>
				Today's Hint
			</a>


			<a 
				href="/past-answers"
				class="text-gray-600 hover:text-black transition"
			>
				Past Answers
			</a>


			<a 
				href="/how-to-play-wordle"
				class="text-gray-600 hover:text-black transition"
			>
				How To Play
			</a>

		</nav>


	</div>


</header>