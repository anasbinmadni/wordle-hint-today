---
import Layout from '../layouts/Layout.astro';

const dateObj = new Date();
const year = dateObj.getFullYear();
const month = String(dateObj.getMonth() + 1).padStart(2, '0');
const day = String(dateObj.getDate()).padStart(2, '0');
const apiDate = `${year}-${month}-${day}`;
const currentDate = dateObj.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

let answer = "SLATE"; 
let todayPuzzleNumber = 1000;

try {
	const response = await fetch(`https://www.nytimes.com/svc/wordle/v2/${apiDate}.json`);
	if (response.ok) {
		const data = await response.json();
		answer = data.solution;
		todayPuzzleNumber = data.days_since_launch;
	}
} catch (error) {
	console.error("API Error: ", error);
}

const word = answer.toLowerCase();
const vowelsArray = ['a', 'e', 'i', 'o', 'u'];
const vowelCount = word.split('').filter(letter => vowelsArray.includes(letter)).length;
const startingLetter = word.charAt(0).toUpperCase();
const endingLetter = word.charAt(word.length - 1).toUpperCase();
const consonantCount = word.length - vowelCount;
const hasRepeating = new Set(word.split('')).size !== word.length;
const repeatingText = hasRepeating ? "Yes, there is a repeating letter today!" : "No, all 5 letters are unique.";

const pastDates = [];
for(let i=1; i<=5; i++) {
	const d = new Date();
	d.setDate(d.getDate() - i);
	const pYear = d.getFullYear();
	const pMonth = String(d.getMonth() + 1).padStart(2, '0');
	const pDay = String(d.getDate()).padStart(2, '0');
	pastDates.push({
		display: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
		link: `/wordle-hint-${todayPuzzleNumber - i}-${pYear}-${pMonth}-${pDay}`
	});
}
---

<Layout title={`Wordle Hint Today (${currentDate}) - Progressive Clues & Answer`}>
	
	<main class="max-w-2xl mx-auto px-4 w-full py-8 md:py-12">
		
		<!-- Header Text -->
		<header class="text-center mb-8">
			<h1 class="text-3xl md:text-4xl font-extrabold mb-2 text-[#1a1a1b] tracking-tight">
				Today's Hints & Clues
			</h1>
			<p class="text-sm md:text-base text-gray-600 font-medium">
				{currentDate} • Puzzle #{todayPuzzleNumber}
			</p>
		</header>

		<!-- Exact NYT Colored Hints Sections -->
		<section class="space-y-3 mb-10 w-full">
			
			<details class="group bg-white rounded-lg border-2 border-[#d3d6da] overflow-hidden [&_summary::-webkit-details-marker]:hidden cursor-pointer">
				<summary class="flex justify-between items-center p-4 md:p-5 hover:bg-gray-50 transition-colors">
					<span class="font-bold text-[#1a1a1b] flex items-center gap-3 text-base md:text-lg">
						<span class="bg-[#c9b458] text-white w-8 h-8 flex items-center justify-center rounded font-bold">V</span> 
						Vowels Check
					</span>
					<span class="text-gray-400 group-open:rotate-180 transition-transform font-bold">▼</span>
				</summary>
				<div class="p-4 md:p-5 border-t-2 border-[#d3d6da] bg-[#c9b458]/10 text-[#1a1a1b] text-base md:text-lg">
					Today's word contains <strong class="text-[#c9b458]">{vowelCount} vowels</strong> and <strong>{consonantCount} consonants</strong>.
				</div>
			</details>

			<details class="group bg-white rounded-lg border-2 border-[#d3d6da] overflow-hidden [&_summary::-webkit-details-marker]:hidden cursor-pointer">
				<summary class="flex justify-between items-center p-4 md:p-5 hover:bg-gray-50 transition-colors">
					<span class="font-bold text-[#1a1a1b] flex items-center gap-3 text-base md:text-lg">
						<span class="bg-[#6aaa64] text-white w-8 h-8 flex items-center justify-center rounded font-bold">S</span> 
						Starting Letter
					</span>
					<span class="text-gray-400 group-open:rotate-180 transition-transform font-bold">▼</span>
				</summary>
				<div class="p-4 md:p-5 border-t-2 border-[#d3d6da] bg-[#6aaa64]/10 text-[#1a1a1b] text-base md:text-lg">
					The word starts with the letter <strong class="text-[#6aaa64] text-2xl uppercase">{startingLetter}</strong>.
				</div>
			</details>

			<details class="group bg-white rounded-lg border-2 border-[#d3d6da] overflow-hidden [&_summary::-webkit-details-marker]:hidden cursor-pointer">
				<summary class="flex justify-between items-center p-4 md:p-5 hover:bg-gray-50 transition-colors">
					<span class="font-bold text-[#1a1a1b] flex items-center gap-3 text-base md:text-lg">
						<span class="bg-[#787c7e] text-white w-8 h-8 flex items-center justify-center rounded font-bold">E</span> 
						Ending Letter
					</span>
					<span class="text-gray-400 group-open:rotate-180 transition-transform font-bold">▼</span>
				</summary>
				<div class="p-4 md:p-5 border-t-2 border-[#d3d6da] bg-gray-100 text-[#1a1a1b] text-base md:text-lg">
					The word ends with the letter <strong class="text-[#787c7e] text-2xl uppercase">{endingLetter}</strong>.
				</div>
			</details>

			<details class="group bg-white rounded-lg border-2 border-[#d3d6da] overflow-hidden [&_summary::-webkit-details-marker]:hidden cursor-pointer">
				<summary class="flex justify-between items-center p-4 md:p-5 hover:bg-gray-50 transition-colors">
					<span class="font-bold text-[#1a1a1b] flex items-center gap-3 text-base md:text-lg">
						<span class="bg-[#1a1a1b] text-white w-8 h-8 flex items-center justify-center rounded font-bold">R</span> 
						Repeating Letters
					</span>
					<span class="text-gray-400 group-open:rotate-180 transition-transform font-bold">▼</span>
				</summary>
				<div class="p-4 md:p-5 border-t-2 border-[#d3d6da] bg-gray-50 text-[#1a1a1b] text-base md:text-lg font-semibold">
					{repeatingText}
				</div>
			</details>

		</section>

		<!-- NYT Style Answer Box -->
		<section class="mb-12 w-full">
			<div class="bg-white rounded-lg border-2 border-[#d3d6da] p-6 text-center">
				<h2 class="text-xl font-bold text-[#1a1a1b] mb-2">Ready to see the answer?</h2>
				<p class="text-gray-500 mb-6 text-sm">Expand below to reveal the solution for puzzle #{todayPuzzleNumber}.</p>
				
				<details class="group inline-block w-full md:w-auto [&_summary::-webkit-details-marker]:hidden cursor-pointer">
					<summary class="bg-[#1a1a1b] text-white font-bold py-4 px-8 rounded hover:bg-gray-800 transition-colors w-full md:w-auto block text-center">
						Reveal Answer
					</summary>
					<div class="mt-6 flex justify-center gap-2">
						<!-- Wordle Style Tiles -->
						{answer.split('').map((letter) => (
							<div class="w-12 h-12 md:w-16 md:h-16 flex items-center justify-center bg-[#6aaa64] text-white text-3xl md:text-4xl font-black uppercase">
								{letter}
							</div>
						))}
					</div>
				</details>
			</div>
		</section>

		<!-- Simple Archive Links -->
		<section class="w-full">
			<h3 class="text-lg font-bold text-[#1a1a1b] mb-4">Previous Puzzles</h3>
			<div class="flex flex-col gap-2">
				{pastDates.map((date) => (
					<a href={date.link} class="flex justify-between items-center p-4 rounded-lg bg-gray-50 hover:bg-gray-100 border border-[#d3d6da] transition-colors font-semibold text-[#1a1a1b]">
						<span>{date.display}</span>
						<span class="text-gray-400">→</span>
					</a>
				))}
			</div>
		</section>

	</main>
</Layout>