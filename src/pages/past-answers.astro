---
import Layout from "../layouts/Layout.astro";
import FAQ from "../components/FAQ.astro";
import SEO from "../components/SEO.astro";

export const prerender = false;

// STRICT EST TIMEZONE FIX
const estTimeString = new Date().toLocaleString("en-US", { timeZone: "America/New_York" });
const today = new Date(estTimeString);

const currentYear = today.getFullYear();
const currentMonth = today.getMonth() + 1;

// Wordle started in June 2021
const startYear = 2021;
const startMonth = 6;

const archiveTree = [];

for (let y = currentYear; y >= startYear; y--) {
    const months = [];
    const lastMonth = (y === currentYear) ? currentMonth : 12;
    const firstMonth = (y === startYear) ? startMonth : 1;

    for (let m = lastMonth; m >= firstMonth; m--) {
        const monthName = new Date(y, m - 1, 1).toLocaleDateString("en-US", { month: "long" });
        const monthStr = String(m).padStart(2, "0");
        months.push({
            name: monthName,
            url: `/archive/${y}/${monthStr}`
        });
    }
    
    archiveTree.push({
        year: y,
        months: months
    });
}

const schema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Wordle Past Answers Archive Hub",
    "description": "Browse previous Wordle answers by year and month. Find complete historical data from 2021 to present.",
    "url": "https://wordlehinttoday.online/past-answers"
};
---

<Layout
    title="Wordle Past Answers Archive - Complete History"
    description="Browse all previous Wordle answers organized by year and month. Find any historical Wordle solution from 2021 to today."
>
    <SEO
        title="Wordle Past Answers Archive - Complete History"
        description="Browse all previous Wordle answers organized by year and month. Find any historical Wordle solution from 2021 to today."
        canonical="/past-answers"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <main class="archive-container fade-in-up">
        <section class="hero">
            <h1>Wordle Archive Directory</h1>
            <p>
                Explore our complete Wordle database. Select a year and month below to view all daily solutions, difficulty ratings, and word statistics for that period.
            </p>
        </section>

        <section class="years-grid">
            {archiveTree.map((yearData) => (
                <div class="year-block">
                    <h2 class="year-heading">{yearData.year} Archive</h2>
                    <div class="months-grid">
                        {yearData.months.map((month) => (
                            <a href={month.url} class="month-card">
                                <h3>{month.name}</h3>
                                <span>View Puzzles →</span>
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </section>

        <section class="archive-help">
            <div class="help-content">
                <h2>Why Use Our Structured Archive?</h2>
                <div class="help-grid">
                    <div class="help-card">
                        <h3>⚡ Lightning Fast</h3>
                        <p>Our organized folders mean you never have to wait for thousands of puzzles to load.</p>
                    </div>
                    <div class="help-card">
                        <h3>📊 Complete History</h3>
                        <p>Access every single Wordle answer ever played since the game launched in June 2021.</p>
                    </div>
                    <div class="help-card">
                        <h3>🏆 Improve Guesses</h3>
                        <p>Study past months to find seasonal word trends and frequently used letter patterns.</p>
                    </div>
                </div>
            </div>
        </section>

        <FAQ />
    </main>
</Layout>

<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .fade-in-up {
        animation: fadeInUp 0.5s ease-out forwards;
    }

    .archive-container { 
        max-width: 1000px; 
        margin: auto; 
        padding: 2rem 1rem; 
        font-family: 'Open Sans', sans-serif;
    }

    .hero { text-align: center; padding: 2rem 0 3rem; }
    .hero h1 { font-family: 'Georgia', serif; font-size: clamp(2.5rem, 5vw, 3.8rem); font-weight: 900; color: #1a1a1b; margin-bottom: 1rem; }
    .hero p { max-width: 700px; margin: 0 auto; color: #555; line-height: 1.8; font-size: 1.1rem; }
    
    .years-grid { margin: 2rem 0 4rem; display: flex; flex-direction: column; gap: 3rem; }
    
    .year-block { background: #ffffff; border: 1px solid #eaeced; border-radius: 24px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
    .year-heading { font-family: 'Georgia', serif; font-size: 2rem; font-weight: 900; color: #1a1a1b; border-bottom: 2px solid #f3f4f6; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    
    .months-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    
    .month-card { background: #fdfbfc; border: 1px solid #e3e6e8; border-radius: 16px; padding: 1.5rem; text-decoration: none; transition: all 0.25s ease; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }
    .month-card:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); border-color: #6aaa64; background: #ffffff; }
    .month-card h3 { font-family: 'Georgia', serif; font-size: 1.3rem; font-weight: 800; color: #1a1a1b; margin-bottom: 0.5rem; }
    .month-card span { font-size: 0.9rem; font-weight: 700; color: #6aaa64; }

    /* Help Section */
    .archive-help { background: #1a1a1b; border-radius: 24px; padding: 4rem 3rem; color: white; margin: 5rem 0; }
    .archive-help h2 { font-family: 'Georgia', serif; font-size: 2.5rem; font-weight: 900; margin-bottom: 2.5rem; text-align: center; }
    .help-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .help-card { padding: 2rem; border-radius: 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); }
    .help-card h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 1rem; color: #fff; }
    .help-card p { color: #a0a5aa; line-height: 1.7; margin: 0; }

    @media (max-width: 900px) {
        .months-grid { grid-template-columns: repeat(3, 1fr); }
        .help-grid { grid-template-columns: 1fr; }
        .archive-help { padding: 3rem 1.5rem; }
    }

    @media (max-width: 600px) {
        .months-grid { grid-template-columns: repeat(2, 1fr); }
        .year-block { padding: 1.5rem; }
        .hero h1 { font-size: 2.5rem; }
    }
</style>