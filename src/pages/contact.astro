---
import Layout from "../layouts/Layout.astro";
import SEO from "../components/SEO.astro";
---

<Layout

title="Contact Wordle Hint Today"

description="Contact Wordle Hint Today for questions, feedback, corrections, and suggestions."

>


<SEO

title="Contact Wordle Hint Today"

description="Get in touch with Wordle Hint Today for feedback, suggestions, and website-related questions."

/>



<main class="contact-page">



<section class="hero">


<h1>
Contact Us
</h1>


<p>
Have a question, suggestion, or feedback? We would love to hear from you.
</p>


</section>




<section class="contact-card">


<h2>
Get In Touch
</h2>


<p>
Wordle Hint Today is built for Wordle enthusiasts. If you notice an issue, have a suggestion, or want to share feedback about our website, please contact us.
</p>



<div class="contact-box">


<div>

<h3>
Email
</h3>


<a href="mailto:hello@wordlehinttoday.online">
hello@wordlehinttoday.online
</a>


</div>



<div>

<h3>
Response Time
</h3>


<p>
We usually respond within a few business days.
</p>


</div>



</div>


</section>





<section class="contact-card">


<h2>
Before Contacting Us
</h2>



<ul>


<li>
For daily Wordle answers, visit our homepage.
</li>


<li>
For previous puzzles, explore our Wordle archive.
</li>


<li>
For privacy questions, review our Privacy Policy.
</li>


</ul>


</section>




<section class="cta">


<h2>
Enjoy Today's Wordle?
</h2>


<p>
Return to our homepage and get today's hints.
</p>


<a href="/">
Go To Today's Hints →
</a>


</section>




</main>



</Layout>




<style>


.contact-page{

max-width:850px;

margin:auto;

padding:3rem 1rem;

}



.hero{

text-align:center;

margin-bottom:3rem;

}



.hero h1{

font-family:Georgia,serif;

font-size:3rem;

font-weight:900;

color:#1a1a1b;

}



.hero p{

color:#666;

font-size:1.1rem;

}



.contact-card{

background:white;

border:1px solid #d3d6da;

border-radius:22px;

padding:2rem;

margin-bottom:1.5rem;

box-shadow:
0 10px 25px rgba(0,0,0,.04);

}



.contact-card h2{

font-family:Georgia,serif;

font-size:1.8rem;

font-weight:900;

margin-bottom:1rem;

}



.contact-card p{

line-height:1.8;

color:#444;

}



.contact-box{

display:grid;

grid-template-columns:1fr 1fr;

gap:1rem;

margin-top:2rem;

}



.contact-box div{

background:#f8f8f8;

padding:1.5rem;

border-radius:16px;

}



.contact-box h3{

font-weight:900;

margin-bottom:.5rem;

}



.contact-box a{

color:#1a1a1b;

font-weight:800;

}



ul{

padding-left:1.5rem;

line-height:2;

color:#444;

}



.cta{

background:#1a1a1b;

color:white;

text-align:center;

padding:3rem 2rem;

border-radius:22px;

}



.cta h2{

font-size:2rem;

font-weight:900;

}



.cta p{

color:#ddd;

margin:1rem 0 2rem;

}



.cta a{

background:white;

color:#1a1a1b;

padding:1rem 2rem;

border-radius:12px;

font-weight:900;

}



@media(max-width:700px){


.hero h1{

font-size:2.2rem;

}


.contact-box{

grid-template-columns:1fr;

}


.contact-card{

padding:1.4rem;

}


}



</style>