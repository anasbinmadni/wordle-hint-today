max-width:900px;

margin:auto;

padding:0 1rem;

}



.answer-preview{

text-align:center;

margin:4rem auto;

padding:2rem;

border-radius:24px;

background:#fafafa;

border:1px solid #ddd;

}



.answer-preview h2{

font-family:Georgia,serif;

font-size:2rem;

font-weight:900;

}




.seo-content{

margin-top:4rem;

line-height:1.8;

}



.seo-content h2{

font-family:Georgia,serif;

font-size:2rem;

font-weight:900;

margin:3rem 0 1rem;

color:#1a1a1b;

}



.steps{

